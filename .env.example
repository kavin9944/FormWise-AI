# =================================================================
# FormWise AI – Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your private configuration values:
#   copy .env.example .env
#
# DO NOT COMMIT .env TO VERSION CONTROL. It contains secret API keys.
# =================================================================

# -----------------------------------------------------------------
# 1. Google Gemini Developer API Configuration (REQUIRED)
# -----------------------------------------------------------------
# Obtain a free API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Recommended models:
#   - gemini-3.5-flash-lite (Recommended: fast, high quota stability)
#   - gemini-3.5-flash
#   - gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------
# 2. Firebase Admin SDK Service Account (REQUIRED FOR FIRESTORE)
# -----------------------------------------------------------------
# Path to your Firebase service account private key JSON file.
# Default lookup order:
#   1. FIREBASE_SERVICE_ACCOUNT_PATH (if set below)
#   2. backend/serviceAccountKey.json
#   3. serviceAccountKey.json (project root)
#
# To generate your own key:
#   1. Go to Firebase Console -> Project Settings -> Service Accounts.
#   2. Click "Generate new private key".
#   3. Save the JSON file as: backend/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=backend/serviceAccountKey.json

# -----------------------------------------------------------------
# 3. Tesseract OCR Configuration (OPTIONAL FOR SCANNED FORMS)
# -----------------------------------------------------------------
# Required only for processing scanned paper forms or image uploads (PNG/JPG).
# Native digital PDF text extraction works automatically without Tesseract.
# Download from: https://github.com/UB-Mannheim/tesseract/wiki
#
# Common Windows installation path:
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng

# -----------------------------------------------------------------
# 4. Flask Server Configuration (OPTIONAL)
# -----------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
